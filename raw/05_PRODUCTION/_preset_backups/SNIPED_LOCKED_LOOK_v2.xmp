   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED_LOCKED_LOOK_v2</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED Locked v2</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED 01 Locked v2</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED · Locked</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED locked-look v2 · the directional version. Inherits BJ's calibrated BASE V2 (Adobe Standard, texture +3, clarity +5, vibrance +10, HSL background desat, split toning, color grade midtone, custom point curve) plus adds lens corrections + chromatic aberration + calibration signature shifts (red hue +3, blue sat +5). Use this as the import default going forward. v1 retired to "modest baseline" reference.</rdf:li>
    </rdf:Alt>
   </crs:Description>
