   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED_LOCKED_LOOK_v1</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED Locked v1</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED 01 Locked v1</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED · Locked</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SNIPED locked-look v1. Base layer applied to every photo on import. Adobe Color profile, lens corrections + CA, locked tone curve (modest S-curve with skin protection: shadows +5 / darks -3 / lights -3 / highlights -8), HSL with skin-warm + background-desat, calibration signature shifts (red hue +3, blue sat +5), sharpening 40, color NR 25. Tune to v2 quarterly against 5 representative SNIPED frames.</rdf:li>
    </rdf:Alt>
   </crs:Description>
  </rdf:Description>
