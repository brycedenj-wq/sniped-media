# === Heavy / replaceable media — kept OFF the brain backup (re-downloadable or regenerated) ===
# Purchased book canon + libgen files
*.epub
*.mobi
*.azw3
*.djvu
# Large book PDFs and rips under raw/ (the canon library lives here, re-downloadable)
raw/**/*.pdf
raw/*.pdf
# Video rips and masters
*.mp4
*.mov
*.mkv
# Image masters / RAW / large binaries (regenerated from source)
*.tiff
*.tif
*.psd
*.psb
*.cr3
*.CR3
# Client / shoot photos: privacy + size, these belong in media storage not the brain repo
*.jpg
*.jpeg
# Archives / disk images
*.zip
*.dmg
# Next.js build output
.next/

